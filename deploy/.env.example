# Copy to .env ON THE SERVER and fill in. Never commit the real file.

# Hostname only, no https:// (e.g. 203-0-113-7.sslip.io, or your own domain later).
SITE_ADDRESS=

# openssl rand -hex 24
DB_PASSWORD=

# openssl rand -base64 32
JWT_SECRET=

# The admin stays secret (it can disable accounts); the demo accounts are public.
ADMIN_EMAIL=admin@stockflow.local
# openssl rand -hex 24
ADMIN_PASSWORD=

# Demo settings.
ORDER_PENDING_EXPIRY=1h
API_DOCS_ENABLED=false

# Written by deploy.sh.
API_IMAGE=
WEB_IMAGE=
DEPLOYED_COMMIT=
