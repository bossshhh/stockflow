# Copy to .env and fill in. .env is git-ignored; never commit real values.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=stockflow
DB_USERNAME=stockflow
DB_PASSWORD=change-me

# Optional: how long a query may wait for a row lock before failing with 409 (default 3s).
# DB_LOCK_TIMEOUT=3s

# Optional rate limits (defaults shown). docker-compose.yml raises the two per-IP ones for local use.
# LOGIN_FAILURES_PER_EMAIL=5
# LOGIN_FAILURES_PER_IP=20
# REGISTRATIONS_PER_IP=10

# Optional: a PENDING order not confirmed within this is cancelled automatically (default 48h).
# ORDER_PENDING_EXPIRY=48h
# HOUSEKEEPING_ENABLED=true

# JWT signing key: base64 of 32+ random bytes. Generate with: openssl rand -base64 32
JWT_SECRET=change-me

# Optional: first admin account, created at startup if it does not exist yet.
ADMIN_EMAIL=admin@stockflow.local
ADMIN_PASSWORD=change-me-to-12+-chars
